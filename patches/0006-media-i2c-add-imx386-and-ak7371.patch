+struct imx386 {
+	struct device *dev;
+	struct regmap *regmap;
+	struct clk *xclk;
+	struct gpio_desc *reset_gpio;
+	struct regulator_bulk_data supplies[ARRAY_SIZE(imx386_supply_names)];
+	unsigned long link_freq_bitmap;
+
+	struct v4l2_subdev sd;
+	struct media_pad pad;
+	struct v4l2_ctrl_handler ctrl_handler;
+	struct v4l2_ctrl *link_freq;
+	struct v4l2_ctrl *pixel_rate;
+	struct v4l2_ctrl *hblank;
+	struct v4l2_ctrl *vblank;
+	struct v4l2_ctrl *exposure;
+	struct v4l2_ctrl *hflip;
+	struct v4l2_ctrl *vflip;
+
+	const struct imx386_mode *cur_mode;
+	bool streaming;
+};
+
+static inline struct imx386 *to_imx386(struct v4l2_subdev *sd)
+{
+	return container_of(sd, struct imx386, sd);
+}
+
+static u32 imx386_get_format_code(struct imx386 *imx386)
+{
+	unsigned int idx = ((imx386->vflip && imx386->vflip->val) ? 2 : 0) |
+			   ((imx386->hflip && imx386->hflip->val) ? 1 : 0);
+
+	return imx386_mbus_formats[idx];
+}
+
+static const struct imx386_mode *
+imx386_find_mode(struct imx386 *imx386, u32 width, u32 height)
+{
+	const struct imx386_mode *best = NULL;
+	unsigned int best_diff = UINT_MAX;
+	unsigned int i;
+
+	for (i = 0; i < ARRAY_SIZE(imx386_modes); i++) {
+		const struct imx386_mode *m = &imx386_modes[i];
+		unsigned int diff;
+
+		if (!(imx386->link_freq_bitmap & BIT(m->link_freq_idx)))
+			continue;
+
+		diff = abs((int)m->width - (int)width) +
+		       abs((int)m->height - (int)height);
+		if (diff < best_diff) {
+			best_diff = diff;
+			best = m;
+		}
+	}
+
+	return best;
+}
+
+static int imx386_power_on(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx386 *imx386 = to_imx386(sd);
+	int i, ret;
+
+	gpiod_set_value_cansleep(imx386->reset_gpio, 1);
+
+	for (i = 0; i < ARRAY_SIZE(imx386_supply_names); i++) {
+		ret = regulator_enable(imx386->supplies[i].consumer);
+		if (ret)
+			goto err_reg;
+		usleep_range(1000, 1100);
+	}
+
+	ret = clk_prepare_enable(imx386->xclk);
+	if (ret)
+		goto err_reg;
+
+	usleep_range(1000, 1100);
+	gpiod_set_value_cansleep(imx386->reset_gpio, 0);
+	usleep_range(11000, 12000);
+
+	return 0;
+
+err_reg:
+	while (--i >= 0)
+		regulator_disable(imx386->supplies[i].consumer);
+	return ret;
+}
+
+static int imx386_power_off(struct device *dev)
+{
+	struct v4l2_subdev *sd = dev_get_drvdata(dev);
+	struct imx386 *imx386 = to_imx386(sd);
+	int i;
+
+	gpiod_set_value_cansleep(imx386->reset_gpio, 1);
+	clk_disable_unprepare(imx386->xclk);
+	for (i = ARRAY_SIZE(imx386_supply_names) - 1; i >= 0; i--)
+		regulator_disable(imx386->supplies[i].consumer);
+
+	return 0;
+}
+
+static int imx386_set_ctrl(struct v4l2_ctrl *ctrl)
+{
+	struct imx386 *imx386 =
+		container_of(ctrl->handler, struct imx386, ctrl_handler);
+	const struct imx386_mode *mode = imx386->cur_mode;
+	u64 val;
+	int ret = 0;
+
+	if (ctrl->id == V4L2_CID_VBLANK) {
+		u32 exp_max = mode->height + ctrl->val - IMX386_EXPOSURE_OFFSET;
+
+		__v4l2_ctrl_modify_range(imx386->exposure,
+					 imx386->exposure->minimum,
+					 exp_max, 1,
+					 min_t(s64, imx386->exposure->val, exp_max));
+	}
+
+	if ((ctrl->id == V4L2_CID_HFLIP || ctrl->id == V4L2_CID_VFLIP) &&
+	    !imx386->streaming) {
+		struct v4l2_subdev_state *state =
+			v4l2_subdev_get_locked_active_state(&imx386->sd);
+		struct v4l2_mbus_framefmt *fmt =
+			v4l2_subdev_state_get_format(state, 0);
+
+		fmt->code = imx386_get_format_code(imx386);
+	}
+
+	if (pm_runtime_get_if_in_use(imx386->dev) <= 0)
+		return 0;
+
+	switch (ctrl->id) {
+	case V4L2_CID_ANALOGUE_GAIN:
+		ret = cci_write(imx386->regmap, IMX386_REG_ANALOG_GAIN,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_DIGITAL_GAIN:
+		val = ctrl->val;
+		ret = cci_write(imx386->regmap, IMX386_REG_DG_GR, val, NULL);
+		cci_write(imx386->regmap, IMX386_REG_DG_R, val, &ret);
+		cci_write(imx386->regmap, IMX386_REG_DG_B, val, &ret);
+		cci_write(imx386->regmap, IMX386_REG_DG_GB, val, &ret);
+		break;
+	case V4L2_CID_EXPOSURE:
+		ret = cci_write(imx386->regmap, IMX386_REG_EXPOSURE,
+				ctrl->val, NULL);
+		break;
+	case V4L2_CID_VBLANK:
+		ret = cci_write(imx386->regmap, IMX386_REG_VTS,
+				mode->height + ctrl->val, NULL);
+		break;
+	case V4L2_CID_HFLIP:
+	case V4L2_CID_VFLIP:
+		ret = cci_write(imx386->regmap, IMX386_REG_ORIENTATION,
+				(imx386->hflip->val ? 1 : 0) |
+				(imx386->vflip->val ? 2 : 0), NULL);
+		break;
+	case V4L2_CID_TEST_PATTERN:
+		ret = cci_write(imx386->regmap, IMX386_REG_TEST_PATTERN,
+				ctrl->val, NULL);
+		break;
+	default:
+		ret = -EINVAL;
+		break;
+	}
+
+	pm_runtime_put(imx386->dev);
+	return ret;
+}
+
+static const struct v4l2_ctrl_ops imx386_ctrl_ops = {
+	.s_ctrl = imx386_set_ctrl,
+};
+
+static int imx386_enable_streams(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state, u32 pad,
+				 u64 streams_mask)
+{
+	struct imx386 *imx386 = to_imx386(sd);
+	int ret;
+
+	ret = pm_runtime_resume_and_get(imx386->dev);
+	if (ret < 0)
+		return ret;
+
+	ret = cci_multi_reg_write(imx386->regmap, imx386_init_regs,
+				  ARRAY_SIZE(imx386_init_regs), NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_multi_reg_write(imx386->regmap, imx386->cur_mode->regs,
+				  imx386->cur_mode->num_regs, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = __v4l2_ctrl_handler_setup(&imx386->ctrl_handler);
+	if (ret)
+		goto err_rpm_put;
+
+	ret = cci_write(imx386->regmap, IMX386_REG_MODE_SELECT,
+			IMX386_MODE_STREAMING, NULL);
+	if (ret)
+		goto err_rpm_put;
+
+	__v4l2_ctrl_grab(imx386->vflip, true);
+	__v4l2_ctrl_grab(imx386->hflip, true);
+	imx386->streaming = true;
+
+	return 0;
+
+err_rpm_put:
+	dev_err(imx386->dev, "failed to start streaming: %d\n", ret);
+	pm_runtime_put_autosuspend(imx386->dev);
+	return ret;
+}
+
+static int imx386_disable_streams(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state, u32 pad,
+				  u64 streams_mask)
+{
+	struct imx386 *imx386 = to_imx386(sd);
+	int ret;
+
+	ret = cci_write(imx386->regmap, IMX386_REG_MODE_SELECT,
+			IMX386_MODE_STANDBY, NULL);
+	if (ret)
+		dev_err(imx386->dev, "failed to stop streaming: %d\n", ret);
+
+	__v4l2_ctrl_grab(imx386->vflip, false);
+	__v4l2_ctrl_grab(imx386->hflip, false);
+	imx386->streaming = false;
+	pm_runtime_put_autosuspend(imx386->dev);
+
+	return ret;
+}
+
+static int imx386_enum_mbus_code(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_mbus_code_enum *code)
+{
+	struct imx386 *imx386 = to_imx386(sd);
+
+	if (code->index > 0)
+		return -EINVAL;
+
+	code->code = imx386_get_format_code(imx386);
+	return 0;
+}
+
+static int imx386_enum_frame_size(struct v4l2_subdev *sd,
+				  struct v4l2_subdev_state *state,
+				  struct v4l2_subdev_frame_size_enum *fse)
+{
+	struct imx386 *imx386 = to_imx386(sd);
+	unsigned int valid_idx = 0;
+	unsigned int i;
+
+	if (fse->code != imx386_get_format_code(imx386))
+		return -EINVAL;
+
+	for (i = 0; i < ARRAY_SIZE(imx386_modes); i++) {
+		if (!(imx386->link_freq_bitmap & BIT(imx386_modes[i].link_freq_idx)))
+			continue;
+		if (valid_idx == fse->index) {
+			fse->min_width = imx386_modes[i].width;
+			fse->max_width = imx386_modes[i].width;
+			fse->min_height = imx386_modes[i].height;
+			fse->max_height = imx386_modes[i].height;
+			return 0;
+		}
+		valid_idx++;
+	}
+
+	return -EINVAL;
+}
+
+static int imx386_set_pad_format(struct v4l2_subdev *sd,
+				 struct v4l2_subdev_state *state,
+				 struct v4l2_subdev_format *fmt)
+{
+	struct imx386 *imx386 = to_imx386(sd);
+	const struct imx386_mode *mode;
+	struct v4l2_mbus_framefmt *framefmt;
+	struct v4l2_rect *crop;
+	int ret;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && imx386->streaming)
+		return -EBUSY;
+
+	mode = imx386_find_mode(imx386, fmt->format.width, fmt->format.height);
+	if (!mode)
+		return -EINVAL;
+
+	fmt->format.code = imx386_get_format_code(imx386);
+	fmt->format.width = mode->width;
+	fmt->format.height = mode->height;
+	fmt->format.field = V4L2_FIELD_NONE;
+	fmt->format.colorspace = V4L2_COLORSPACE_RAW;
+	fmt->format.ycbcr_enc = V4L2_YCBCR_ENC_601;
+	fmt->format.quantization = V4L2_QUANTIZATION_FULL_RANGE;
+	fmt->format.xfer_func = V4L2_XFER_FUNC_NONE;
+
+	framefmt = v4l2_subdev_state_get_format(state, 0);
+	*framefmt = fmt->format;
+
+	crop = v4l2_subdev_state_get_crop(state, 0);
+	*crop = mode->crop;
+
+	if (fmt->which == V4L2_SUBDEV_FORMAT_ACTIVE && imx386->cur_mode != mode) {
+		u32 hblank = mode->hts_def - mode->width;
+		u32 vblank_def = mode->vts_def - mode->height;
+		u32 exp_max = mode->vts_def - IMX386_EXPOSURE_OFFSET;
+
+		imx386->cur_mode = mode;
+
+		ret = __v4l2_ctrl_s_ctrl(imx386->link_freq, mode->link_freq_idx);
+		if (ret)
+			return ret;
+
+		ret = __v4l2_ctrl_modify_range(imx386->pixel_rate,
+					       mode->pixel_rate,
+					       mode->pixel_rate,
+					       1, mode->pixel_rate);
+		if (ret)
+			return ret;
+
+		ret = __v4l2_ctrl_modify_range(imx386->hblank, hblank, hblank,
+					       1, hblank);
+		if (ret)
+			return ret;
+
+		ret = __v4l2_ctrl_modify_range(imx386->vblank, vblank_def,
+					       IMX386_VTS_MAX - mode->height,
+					       1, vblank_def);
+		if (ret)
+			return ret;
+
+		ret = __v4l2_ctrl_s_ctrl(imx386->vblank, vblank_def);
+		if (ret)
+			return ret;
+
+		ret = __v4l2_ctrl_modify_range(imx386->exposure,
+					       IMX386_EXPOSURE_MIN, exp_max,
+					       1, min_t(u32, IMX386_EXPOSURE_DEFAULT, exp_max));
+		if (ret)
+			return ret;
+	}
+
+	return 0;
+}
+
+static int imx386_get_selection(struct v4l2_subdev *sd,
+				struct v4l2_subdev_state *state,
+				struct v4l2_subdev_selection *sel)
+{
+	switch (sel->target) {
+	case V4L2_SEL_TGT_CROP:
+		sel->r = *v4l2_subdev_state_get_crop(state, 0);
+		return 0;
+	case V4L2_SEL_TGT_NATIVE_SIZE:
+	case V4L2_SEL_TGT_CROP_DEFAULT:
+	case V4L2_SEL_TGT_CROP_BOUNDS:
+		sel->r.left = 0;
+		sel->r.top = 0;
+		sel->r.width = IMX386_NATIVE_WIDTH;
+		sel->r.height = IMX386_NATIVE_HEIGHT;
+		return 0;
+	default:
+		return -EINVAL;
+	}
+}
+
+static int imx386_init_state(struct v4l2_subdev *sd,
+			     struct v4l2_subdev_state *state)
+{
+	struct v4l2_subdev_format fmt = {
+		.which = V4L2_SUBDEV_FORMAT_TRY,
+		.pad = 0,
+		.format = {
+			.code = MEDIA_BUS_FMT_SRGGB10_1X10,
+			.width = IMX386_NATIVE_WIDTH,
+			.height = IMX386_NATIVE_HEIGHT,
+		},
+	};
+
+	return imx386_set_pad_format(sd, state, &fmt);
+}
+
+static const struct v4l2_subdev_video_ops imx386_video_ops = {
+	.s_stream = v4l2_subdev_s_stream_helper,
+};
+
+static const struct v4l2_subdev_pad_ops imx386_pad_ops = {
+	.enum_mbus_code = imx386_enum_mbus_code,
+	.get_fmt = v4l2_subdev_get_fmt,
+	.set_fmt = imx386_set_pad_format,
+	.get_selection = imx386_get_selection,
+	.enum_frame_size = imx386_enum_frame_size,
+	.enable_streams = imx386_enable_streams,
+	.disable_streams = imx386_disable_streams,
+};
+
+static const struct v4l2_subdev_ops imx386_subdev_ops = {
+	.video = &imx386_video_ops,
+	.pad = &imx386_pad_ops,
+};
+
+static const struct v4l2_subdev_internal_ops imx386_internal_ops = {
+	.init_state = imx386_init_state,
+};
+
+static const struct media_entity_operations imx386_subdev_entity_ops = {
+	.link_validate = v4l2_subdev_link_validate,
+};
+
+static int imx386_init_controls(struct imx386 *imx386)
+{
+	struct v4l2_fwnode_device_properties props;
+	const struct imx386_mode *mode = imx386->cur_mode;
+	struct v4l2_ctrl_handler *hdl = &imx386->ctrl_handler;
+	u32 hblank = mode->hts_def - mode->width;
+	u32 vblank_def = mode->vts_def - mode->height;
+	u32 exp_max = mode->vts_def - IMX386_EXPOSURE_OFFSET;
+	int ret;
+
+	v4l2_ctrl_handler_init(hdl, 12);
+
+	imx386->link_freq = v4l2_ctrl_new_int_menu(hdl, &imx386_ctrl_ops,
+			V4L2_CID_LINK_FREQ,
+			ARRAY_SIZE(imx386_link_freq_menu) - 1,
+			mode->link_freq_idx,
+			imx386_link_freq_menu);
+	if (imx386->link_freq)
+		imx386->link_freq->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx386->pixel_rate = v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops,
+			V4L2_CID_PIXEL_RATE,
+			mode->pixel_rate, mode->pixel_rate, 1,
+			mode->pixel_rate);
+
+	imx386->hblank = v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops,
+			V4L2_CID_HBLANK, hblank, hblank, 1, hblank);
+	if (imx386->hblank)
+		imx386->hblank->flags |= V4L2_CTRL_FLAG_READ_ONLY;
+
+	imx386->vblank = v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops,
+			V4L2_CID_VBLANK, vblank_def,
+			IMX386_VTS_MAX - mode->height, 1, vblank_def);
+
+	v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops, V4L2_CID_ANALOGUE_GAIN,
+			  IMX386_ANA_GAIN_MIN, IMX386_ANA_GAIN_MAX, 1,
+			  IMX386_ANA_GAIN_DEFAULT);
+
+	v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops, V4L2_CID_DIGITAL_GAIN,
+			  IMX386_DGTL_GAIN_MIN, IMX386_DGTL_GAIN_MAX, 1,
+			  IMX386_DGTL_GAIN_DEFAULT);
+
+	imx386->exposure = v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops,
+			V4L2_CID_EXPOSURE, IMX386_EXPOSURE_MIN,
+			exp_max, 1, IMX386_EXPOSURE_DEFAULT);
+
+	v4l2_ctrl_new_std_menu_items(hdl, &imx386_ctrl_ops,
+				     V4L2_CID_TEST_PATTERN,
+				     ARRAY_SIZE(imx386_test_pattern_menu) - 1,
+				     0, 0, imx386_test_pattern_menu);
+
+	imx386->hflip = v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops,
+			V4L2_CID_HFLIP, 0, 1, 1, 0);
+	if (imx386->hflip)
+		imx386->hflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	imx386->vflip = v4l2_ctrl_new_std(hdl, &imx386_ctrl_ops,
+			V4L2_CID_VFLIP, 0, 1, 1, 0);
+	if (imx386->vflip)
+		imx386->vflip->flags |= V4L2_CTRL_FLAG_MODIFY_LAYOUT;
+
+	if (hdl->error) {
+		ret = hdl->error;
+		goto err_free;
+	}
+
+	ret = v4l2_fwnode_device_parse(imx386->dev, &props);
+	if (ret)
+		goto err_free;
+
+	ret = v4l2_ctrl_new_fwnode_properties(hdl, &imx386_ctrl_ops, &props);
+	if (ret)
+		goto err_free;
+
+	imx386->sd.ctrl_handler = hdl;
+	return 0;
+
+err_free:
+	v4l2_ctrl_handler_free(hdl);
+	return ret;
+}
+
+static int imx386_check_hwcfg(struct device *dev, struct imx386 *imx386)
+{
+	struct v4l2_fwnode_endpoint ep_cfg = {
+		.bus_type = V4L2_MBUS_CSI2_DPHY,
+	};
+	struct fwnode_handle *ep;
+	unsigned int i, j;
+	int ret;
+
+	ep = fwnode_graph_get_next_endpoint(dev_fwnode(dev), NULL);
+	if (!ep)
+		return -EINVAL;
+
+	ret = v4l2_fwnode_endpoint_alloc_parse(ep, &ep_cfg);
+	fwnode_handle_put(ep);
+	if (ret)
+		return ret;
+
+	if (ep_cfg.bus.mipi_csi2.num_data_lanes != 4) {
+		dev_err_probe(dev, -EINVAL, "invalid number of data lanes: %u\n",
+			      ep_cfg.bus.mipi_csi2.num_data_lanes);
+		ret = -EINVAL;
+		goto out_free;
+	}
+
+	for (i = 0; i < ep_cfg.nr_of_link_frequencies; i++) {
+		for (j = 0; j < ARRAY_SIZE(imx386_link_freq_menu); j++) {
+			if (ep_cfg.link_frequencies[i] == imx386_link_freq_menu[j])
+				imx386->link_freq_bitmap |= BIT(j);
+		}
+	}
+
+	if (!imx386->link_freq_bitmap) {
+		dev_err_probe(dev, -EINVAL, "no supported link frequencies found\n");
+		ret = -EINVAL;
+	}
+
+out_free:
+	v4l2_fwnode_endpoint_free(&ep_cfg);
+	return ret;
+}
+
+static int imx386_probe(struct i2c_client *client)
+{
+	struct device *dev = &client->dev;
+	struct imx386 *imx386;
+	unsigned long xclk_freq;
+	u64 chip_id = 0;
+	int i, ret;
+
+	imx386 = devm_kzalloc(dev, sizeof(*imx386), GFP_KERNEL);
+	if (!imx386)
+		return -ENOMEM;
+
+	imx386->dev = dev;
+	v4l2_i2c_subdev_init(&imx386->sd, client, &imx386_subdev_ops);
+
+	imx386->regmap = devm_cci_regmap_init_i2c(client, 16);
+	if (IS_ERR(imx386->regmap))
+		return dev_err_probe(dev, PTR_ERR(imx386->regmap),
+				     "failed to init CCI\n");
+
+	imx386->xclk = devm_clk_get(dev, NULL);
+	if (IS_ERR(imx386->xclk))
+		return dev_err_probe(dev, PTR_ERR(imx386->xclk),
+				     "failed to get MCLK clock\n");
+
+	xclk_freq = clk_get_rate(imx386->xclk);
+	if (xclk_freq != IMX386_XCLK_FREQ) {
+		ret = clk_set_rate(imx386->xclk, IMX386_XCLK_FREQ);
+		if (!ret)
+			xclk_freq = clk_get_rate(imx386->xclk);
+	}
+	if (xclk_freq != IMX386_XCLK_FREQ)
+		return dev_err_probe(dev, -EINVAL,
+				     "MCLK clock frequency %lu is not supported\n",
+				     xclk_freq);
+
+	ret = imx386_check_hwcfg(dev, imx386);
+	if (ret)
+		return ret;
+
+	imx386->reset_gpio = devm_gpiod_get_optional(dev, "reset", GPIOD_OUT_HIGH);
+	if (IS_ERR(imx386->reset_gpio))
+		return dev_err_probe(dev, PTR_ERR(imx386->reset_gpio),
+				     "cannot get reset GPIO\n");
+
+	for (i = 0; i < ARRAY_SIZE(imx386_supply_names); i++)
+		imx386->supplies[i].supply = imx386_supply_names[i];
+
+	ret = devm_regulator_bulk_get(dev, ARRAY_SIZE(imx386_supply_names),
+				      imx386->supplies);
+	if (ret)
+		return dev_err_probe(dev, ret, "failed to get supply regulators\n");
+
+	ret = imx386_power_on(dev);
+	if (ret)
+		return ret;
+
+	ret = cci_read(imx386->regmap, IMX386_REG_CHIP_ID, &chip_id, NULL);
+	if (ret) {
+		dev_err_probe(dev, ret, "failed to read chip id\n");
+		goto err_power_off;
+	}
+
+	if (chip_id != IMX386_CHIP_ID) {
+		ret = dev_err_probe(dev, -ENODEV,
+				    "chip id mismatch: %x!=%llx\n",
+				    IMX386_CHIP_ID, chip_id);
+		goto err_power_off;
+	}
+
+	dev_info(dev, "IMX386 chip ID verified: 0x%04llx\n", chip_id);
+
+	imx386->cur_mode = imx386_find_mode(imx386, IMX386_NATIVE_WIDTH,
+					    IMX386_NATIVE_HEIGHT);
+	if (!imx386->cur_mode) {
+		ret = -EINVAL;
+		goto err_power_off;
+	}
+
+	ret = imx386_init_controls(imx386);
+	if (ret)
+		goto err_power_off;
+
+	imx386->sd.internal_ops = &imx386_internal_ops;
+	imx386->sd.flags |= V4L2_SUBDEV_FL_HAS_DEVNODE;
+	imx386->sd.entity.function = MEDIA_ENT_F_CAM_SENSOR;
+	imx386->sd.entity.ops = &imx386_subdev_entity_ops;
+	imx386->pad.flags = MEDIA_PAD_FL_SOURCE;
+
+	ret = media_entity_pads_init(&imx386->sd.entity, 1, &imx386->pad);
+	if (ret)
+		goto err_free_ctrl;
+
+	imx386->sd.state_lock = imx386->ctrl_handler.lock;
+	ret = v4l2_subdev_init_finalize(&imx386->sd);
+	if (ret)
+		goto err_media_cleanup;
+
+	pm_runtime_set_active(dev);
+	pm_runtime_enable(dev);
+
+	ret = v4l2_async_register_subdev_sensor(&imx386->sd);
+	if (ret)
+		goto err_subdev_cleanup;
+
+	pm_runtime_set_autosuspend_delay(dev, 1000);
+	pm_runtime_use_autosuspend(dev);
+	pm_runtime_idle(dev);
+
+	return 0;
+
+err_subdev_cleanup:
+	v4l2_subdev_cleanup(&imx386->sd);
+	pm_runtime_disable(dev);
+	pm_runtime_set_suspended(dev);
+err_media_cleanup:
+	media_entity_cleanup(&imx386->sd.entity);
+err_free_ctrl:
+	v4l2_ctrl_handler_free(&imx386->ctrl_handler);
+err_power_off:
+	imx386_power_off(dev);
+	return ret;
+}
+
+static void imx386_remove(struct i2c_client *client)
+{
+	struct v4l2_subdev *sd = i2c_get_clientdata(client);
+	struct imx386 *imx386 = to_imx386(sd);
+
+	v4l2_async_unregister_subdev(sd);
+	v4l2_subdev_cleanup(sd);
+	media_entity_cleanup(&sd->entity);
+	v4l2_ctrl_handler_free(&imx386->ctrl_handler);
+
+	pm_runtime_disable(&client->dev);
+	if (!pm_runtime_status_suspended(&client->dev)) {
+		imx386_power_off(&client->dev);
+		pm_runtime_set_suspended(&client->dev);
+	}
+}
+
+static const struct of_device_id imx386_of_match[] = {
+	{ .compatible = "sony,imx386" },
+	{ /* sentinel */ }
+};
+MODULE_DEVICE_TABLE(of, imx386_of_match);
+
+static const struct dev_pm_ops imx386_pm_ops = {
+	SET_RUNTIME_PM_OPS(imx386_power_off, imx386_power_on, NULL)
+};
+
+static struct i2c_driver imx386_i2c_driver = {
+	.driver = {
+		.name = "imx386",
+		.of_match_table = imx386_of_match,
+		.pm = &imx386_pm_ops,
+	},
+	.probe = imx386_probe,
+	.remove = imx386_remove,
+};
+module_i2c_driver(imx386_i2c_driver);
