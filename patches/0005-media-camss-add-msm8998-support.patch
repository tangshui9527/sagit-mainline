From: tangshui9527 <tangshui1122@gmail.com>
Subject: [PATCH] media: qcom: camss: add MSM8998 support

---
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
index dac8d2e..0a0c1e9 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy-3ph-1-0.c
@@ -1074,7 +1074,8 @@ static void csiphy_gen1_config_lanes(struct csiphy_device *csiphy,
 	val = CSIPHY_3PH_LNn_CFG1_SWI_REC_DLY_PRG;
 	writel_relaxed(val, csiphy->base + CSIPHY_3PH_LNn_CFG1(l));
 
-	if (csiphy->camss->res->version == CAMSS_660)
+	if (csiphy->camss->res->version == CAMSS_660 ||
+	    csiphy->camss->res->version == CAMSS_8998)
 		val = CSIPHY_3PH_LNn_CFG4_T_HS_CLK_MISS_660;
 	else
 		val = CSIPHY_3PH_LNn_CFG4_T_HS_CLK_MISS;
diff --git a/drivers/media/platform/qcom/camss/camss-csiphy.c b/drivers/media/platform/qcom/camss/camss-csiphy.c
index 539ac48..890e693 100644
--- a/drivers/media/platform/qcom/camss/camss-csiphy.c
+++ b/drivers/media/platform/qcom/camss/camss-csiphy.c
@@ -606,7 +606,8 @@ int msm_csiphy_subdev_init(struct camss *camss,
 	if (camss->res->version == CAMSS_8x16 ||
 	    camss->res->version == CAMSS_8x39 ||
 	    camss->res->version == CAMSS_8x53 ||
-	    camss->res->version == CAMSS_8x96) {
+	    camss->res->version == CAMSS_8x96 ||
+	    camss->res->version == CAMSS_8998) {
 		csiphy->base_clk_mux =
 			devm_platform_ioremap_resource_byname(pdev, res->reg[1]);
 		if (IS_ERR(csiphy->base_clk_mux))
@@ -686,7 +687,8 @@ int msm_csiphy_subdev_init(struct camss *camss,
 		if (csiphy->rate_set[i])
 			continue;
 
-		if (camss->res->version == CAMSS_660) {
+		if (camss->res->version == CAMSS_660 ||
+		    camss->res->version == CAMSS_8998) {
 			csiphy->rate_set[i] = csiphy_match_clock_name(clock->name,
 								      "csi%d_phy",
 								       csiphy->id);
diff --git a/drivers/media/platform/qcom/camss/camss-ispif.c b/drivers/media/platform/qcom/camss/camss-ispif.c
index 20ccd7b..fe7ed7f 100644
--- a/drivers/media/platform/qcom/camss/camss-ispif.c
+++ b/drivers/media/platform/qcom/camss/camss-ispif.c
@@ -831,7 +831,8 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 		ispif_config_irq(ispif, intf, vfe, 1);
 		if (camss->res->version == CAMSS_8x96 ||
 		    camss->res->version == CAMSS_8x53 ||
-		    camss->res->version == CAMSS_660)
+		    camss->res->version == CAMSS_660 ||
+		    camss->res->version == CAMSS_8998)
 			ispif_config_pack(ispif,
 					  line->fmt[MSM_ISPIF_PAD_SINK].code,
 					  intf, cid, vfe, 1);
@@ -850,7 +851,8 @@ static int ispif_set_stream(struct v4l2_subdev *sd, int enable)
 		mutex_lock(&ispif->config_lock);
 		if (camss->res->version == CAMSS_8x96 ||
 		    camss->res->version == CAMSS_8x53 ||
-		    camss->res->version == CAMSS_660)
+		    camss->res->version == CAMSS_660 ||
+		    camss->res->version == CAMSS_8998)
 			ispif_config_pack(ispif,
 					  line->fmt[MSM_ISPIF_PAD_SINK].code,
 					  intf, cid, vfe, 0);
@@ -1116,7 +1118,8 @@ int msm_ispif_subdev_init(struct camss *camss,
 		ispif->line_num = 3;
 	else if (camss->res->version == CAMSS_8x96 ||
 		 camss->res->version == CAMSS_8x53 ||
-		 camss->res->version == CAMSS_660)
+		 camss->res->version == CAMSS_660 ||
+		 camss->res->version == CAMSS_8998)
 		ispif->line_num = 4;
 	else
 		return -EINVAL;
@@ -1137,7 +1140,8 @@ int msm_ispif_subdev_init(struct camss *camss,
 					ARRAY_SIZE(ispif_formats_8x16);
 		} else if (camss->res->version == CAMSS_8x96 ||
 			   camss->res->version == CAMSS_8x53 ||
-			   camss->res->version == CAMSS_660) {
+			   camss->res->version == CAMSS_660 ||
+			   camss->res->version == CAMSS_8998) {
 			ispif->line[i].formats = ispif_formats_8x96;
 			ispif->line[i].nformats =
 					ARRAY_SIZE(ispif_formats_8x96);
@@ -1171,7 +1175,8 @@ int msm_ispif_subdev_init(struct camss *camss,
 			       IRQF_TRIGGER_RISING, ispif->irq_name, ispif);
 	else if (camss->res->version == CAMSS_8x96 ||
 		 camss->res->version == CAMSS_8x53 ||
-		 camss->res->version == CAMSS_660)
+		 camss->res->version == CAMSS_660 ||
+		 camss->res->version == CAMSS_8998)
 		ret = devm_request_irq(dev, ispif->irq, ispif_isr_8x96,
 			       IRQF_TRIGGER_RISING, ispif->irq_name, ispif);
 	else
diff --git a/drivers/media/platform/qcom/camss/camss-vfe.c b/drivers/media/platform/qcom/camss/camss-vfe.c
