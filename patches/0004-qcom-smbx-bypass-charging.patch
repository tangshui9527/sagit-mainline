+static int smb_get_charge_current_max(struct smb_chip *chip, int *val)
+{
+	unsigned int reg;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->base + FAST_CHARGE_CURRENT_CFG, &reg);
+	if (rc < 0)
+		return rc;
+
+	*val = (reg & FAST_CHARGE_CURRENT_SETTING_MASK) * CURRENT_SCALE_FACTOR;
+	return 0;
+}
+
+static int smb_set_charge_current_max(struct smb_chip *chip, int val)
+{
+	int max_ua = 1000000;
+	int rc;
+
+	if (chip->batt_info && chip->batt_info->constant_charge_current_max_ua > 0)
+		max_ua = min_t(int, chip->batt_info->constant_charge_current_max_ua, 3200000);
+
+	if (val < 0 || val > max_ua)
+		return -EINVAL;
+
+	rc = regmap_update_bits(chip->regmap, chip->base + FAST_CHARGE_CURRENT_CFG,
+				FAST_CHARGE_CURRENT_SETTING_MASK,
+				val / CURRENT_SCALE_FACTOR);
+	if (!rc)
+		power_supply_changed(chip->chg_psy);
+
+	return rc;
+}
+
+static int smb_get_prop_charge_behaviour(struct smb_chip *chip, int *val)
+{
+	unsigned int reg;
+	int rc;
+
+	rc = regmap_read(chip->regmap, chip->base + CHARGING_ENABLE_CMD, &reg);
+	if (rc < 0)
+		return rc;
+
+	if (reg & CHARGING_ENABLE_CMD_BIT)
+		*val = POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO;
+	else
+		*val = POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE;
+
+	return 0;
 }
 
+static int smb_set_prop_charge_behaviour(struct smb_chip *chip, int val)
+{
+	unsigned int cmd;
+	int rc;
+
+	switch (val) {
+	case POWER_SUPPLY_CHARGE_BEHAVIOUR_AUTO:
+		cmd = CHARGING_ENABLE_CMD_BIT;
+		break;
+	case POWER_SUPPLY_CHARGE_BEHAVIOUR_INHIBIT_CHARGE:
+		cmd = 0;
+		break;
+	default:
+		return -EINVAL;
+	}
+
+	rc = regmap_update_bits(chip->regmap, chip->base + CHARGING_ENABLE_CMD,
+				CHARGING_ENABLE_CMD_BIT, cmd);
+	if (!rc)
+		power_supply_changed(chip->chg_psy);
+
+	return rc;
+}
