/dts-v1/;

/ {
	#address-cells = <0x02>;
	model = "Xiaomi Mi 6";
	qcom,board-id = <0x1e 0x00>;
	#size-cells = <0x02>;
	interrupt-parent = <0x01>;
	compatible = "xiaomi,sagit", "qcom,msm8998";
	qcom,msm-id = <0x124 0x00>;
	chassis-type = "handset";

	soc@0 {
		#address-cells = <0x01>;
		#size-cells = <0x01>;
		compatible = "simple-bus";
		ranges = <0x00 0x00 0x00 0xffffffff>;

		restart@10ac000 {
			compatible = "qcom,pshold";
			reg = <0x010ac000 0x04>;
		};

		video-codec@cc00000 {
			power-domains = <0x98 0x01>;
			iommus = <0x99 0x400 0x99 0x401 0x99 0x40a 0x99 0x407 0x99 0x40e 0x99 0x40f 0x99 0x408 0x99 0x409 0x99 0x40b 0x99 0x40c 0x99 0x40d 0x99 0x410 0x99 0x421 0x99 0x428 0x99 0x429 0x99 0x42b 0x99 0x42c 0x99 0x42d 0x99 0x411 0x99 0x431>;
			clock-names = "core", "iface", "bus", "mbus";
			memory-region = <0xa8>;
			interrupts = <0x00 0x11f 0x04>;
			clocks = <0x98 0x38 0x98 0x39 0x98 0x3a 0x98 0x3b>;
			compatible = "qcom,msm8998-venus";
			status = "disabled";
			reg = <0xcc00000 0xff000>;

			video-encoder {
				power-domains = <0x98 0x03>;
				clock-names = "core";
				clocks = <0x98 0x3d>;
				compatible = "venus-encoder";
			};

			video-decoder {
				power-domains = <0x98 0x02>;
				clock-names = "core";
				clocks = <0x98 0x3c>;
				compatible = "venus-decoder";
			};
		};

		spi@c1b9000 {
			pinctrl-names = "default";
			#address-cells = <0x01>;
			pinctrl-0 = <0x93>;
			clock-names = "core", "iface";
			interrupts = <0x00 0x69 0x04>;
			clocks = <0x25 0x40 0x25 0x36>;
			#size-cells = <0x00>;
			dma-names = "tx", "rx";
			compatible = "qcom,spi-qup-v2.2.1";
			status = "disabled";
			reg = <0xc1b9000 0x600>;
			dmas = <0x82 0x0e 0x82 0x0f>;
		};

		iommu@cd00000 {
			power-domains = <0x98 0x09>;
			#global-interrupts = <0x00>;
			clock-names = "iface-mm", "iface-smmu", "bus-smmu";
			interrupts = <0x00 0x107 0x04 0x00 0x10a 0x04 0x00 0x10b 0x04 0x00 0x10c 0x04 0x00 0xf4 0x04 0x00 0xf5 0x04 0x00 0xf7 0x04 0x00 0xf8 0x04 0x00 0xf9 0x04 0x00 0xfa 0x04 0x00 0xfb 0x04 0x00 0xfc 0x04 0x00 0xfd 0x04 0x00 0xfe 0x04 0x00 0xff 0x04 0x00 0x100 0x04 0x00 0x104 0x04 0x00 0x105 0x04 0x00 0x106 0x04 0x00 0x110 0x04>;
			clocks = <0x98 0x8c 0x98 0x8d 0x98 0x8e>;
			#iommu-cells = <0x01>;
			compatible = "qcom,msm8998-smmu-v2", "qcom,smmu-v2", "qcom,adreno-smmu";
			reg = <0xcd00000 0x40000>;
			phandle = <0x99>;
		};

		iommu@1680000 {
			#global-interrupts = <0x00>;
			interrupts = <0x00 0x16c 0x01 0x00 0x16d 0x01 0x00 0x16e 0x01 0x00 0x16f 0x01 0x00 0x170 0x01 0x00 0x171 0x01>;
			#iommu-cells = <0x01>;
			compatible = "qcom,msm8998-smmu-v2", "qcom,smmu-v2";
			reg = <0x1680000 0x10000>;
			phandle = <0x26>;
		};

		clock-controller@c8c0000 {
			#reset-cells = <0x01>;
			clock-names = "xo", "gpll0", "dsi0dsi", "dsi0byte", "dsi1dsi", "dsi1byte", "hdmipll", "dplink", "dpvco", "gpll0_div";
			clocks = <0x22 0x00 0x25 0xb2 0x95 0x01 0x95 0x00 0x96 0x01 0x96 0x00 0x97 0x00 0x00 0x25 0xb8>;
			#clock-cells = <0x01>;
			#power-domain-cells = <0x01>;
			compatible = "qcom,mmcc-msm8998";
			reg = <0xc8c0000 0x40000>;
			phandle = <0x98>;
		};

		interrupt-controller@17a00000 {
			#address-cells = <0x01>;
			#redistributor-regions = <0x01>;
			interrupts = <0x01 0x09 0x04>;
			#size-cells = <0x01>;
			redistributor-stride = <0x00 0x20000>;
			compatible = "arm,gic-v3";
			ranges;
			#interrupt-cells = <0x03>;
			reg = <0x17a00000 0x10000 0x17b00000 0x100000>;
			phandle = <0x01>;
			interrupt-controller;
		};

		spi@c1b6000 {
			pinctrl-names = "default";
			#address-cells = <0x01>;
			pinctrl-0 = <0x90>;
			clock-names = "core", "iface";
			interrupts = <0x00 0x66 0x04>;
			clocks = <0x25 0x3a 0x25 0x36>;
			#size-cells = <0x00>;
			dma-names = "tx", "rx";
			compatible = "qcom,spi-qup-v2.2.1";
			status = "disabled";
			reg = <0xc1b6000 0x600>;
			dmas = <0x82 0x08 0x82 0x09>;
		};

		iommu@5040000 {
			power-domains = <0x35 0x02>;
			#global-interrupts = <0x00>;
			clock-names = "iface", "mem", "mem_iface";
			interrupts = <0x00 0x149 0x04 0x00 0x14a 0x04 0x00 0x14b 0x04>;
			clocks = <0x25 0x4d 0x25 0xb0 0x25 0x4b>;
			#iommu-cells = <0x01>;
			compatible = "qcom,msm8998-smmu-v2", "qcom,smmu-v2";
			reg = <0x5040000 0x10000>;
			phandle = <0x36>;
		};

		etm@7f40000 {
			clock-names = "apb_pclk", "atclk";
			clocks = <0x22 0x08 0x22 0x09>;
			cpu = <0x0f>;
			compatible = "arm,coresight-etm4x", "arm,primecell";
			status = "disabled";
			reg = <0x7f40000 0x1000>;

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0x5b>;
						phandle = <0x55>;
					};
				};
			};
		};

		spmi@800f000 {
			#address-cells = <0x02>;
			reg-names = "core", "chnls", "obsrvr", "intr", "cnfg";
			qcom,channel = <0x00>;
			interrupts = <0x00 0x146 0x04>;
			#size-cells = <0x00>;
			compatible = "qcom,spmi-pmic-arb";
			#interrupt-cells = <0x04>;
			interrupt-names = "periph_irq";
			reg = <0x800f000 0x1000 0x8400000 0x1000000 0x9400000 0x1000000 0xa400000 0x220000 0x800a000 0x3000>;
			qcom,ee = <0x00>;
			interrupt-controller;

			pmic@4 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,pm8005", "qcom,spmi-pmic";
				reg = <0x04 0x00>;

				gpio@c000 {
					gpio-controller;
					compatible = "qcom,pm8005-gpio", "qcom,spmi-gpio";
					#interrupt-cells = <0x02>;
					reg = <0xc000>;
					phandle = <0x5c>;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x5c 0x00 0x00 0x04>;
					interrupt-controller;
				};
			};

			pmic@2 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,pmi8998", "qcom,spmi-pmic";
				reg = <0x02 0x00>;

				gpio@c000 {
					gpio-controller;
					compatible = "qcom,pmi8998-gpio", "qcom,spmi-gpio";
					#interrupt-cells = <0x02>;
					reg = <0xc000>;
					phandle = <0x60>;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x60 0x00 0x00 0x0e>;
					interrupt-controller;
				};

				adc@4500 {
					#io-channel-cells = <0x01>;
					compatible = "qcom,pmi8998-rradc";
					reg = <0x4500>;
					phandle = <0x5f>;
				};

				fuel-gauge@4000 {
					qcom,max-voltage-uv = <0x432380>;
					monitored-battery = <0xb1>;
					interrupts = <0x02 0x40 0x03 0x01 0x02 0x13 0x04 0x03>;
					qcom,min-voltage-uv = <0x387520>;
					charge-full-design-microamp-hours = <0x331df0>;
					compatible = "qcom,pmi8998-fg";
					status = "okay";
					interrupt-names = "soc-delta", "usb-plugin";
					reg = <0x4000 0x1000>;
				};

				charger@1000 {
					monitored-battery = <0xb1>;
					interrupts = <0x02 0x13 0x04 0x03 0x02 0x12 0x02 0x03 0x02 0x16 0x01 0x01 0x02 0x13 0x06 0x01>;
					io-channels = <0x5f 0x03 0x5f 0x04>;
					compatible = "qcom,pmi8998-charger";
					status = "okay";
					interrupt-names = "usb-plugin", "bat-ov", "wdog-bark", "usbin-icl-change";
					reg = <0x1000>;
					io-channel-names = "usbin_i", "usbin_v";
				};
			};

			pmic@0 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,pm8998", "qcom,spmi-pmic";
				reg = <0x00 0x00>;

				charger@2800 {
					compatible = "qcom,pm8998-coincell", "qcom,pm8941-coincell";
					status = "disabled";
					reg = <0x2800>;
				};

				temp-alarm@2400 {
					interrupts = <0x00 0x24 0x00 0x01>;
					io-channels = <0x5d 0x06>;
					#thermal-sensor-cells = <0x00>;
					compatible = "qcom,spmi-temp-alarm";
					reg = <0x2400>;
					phandle = <0x21>;
					io-channel-names = "thermal";
				};

				gpio@c000 {
					gpio-controller;
					compatible = "qcom,pm8998-gpio", "qcom,spmi-gpio";
					#interrupt-cells = <0x02>;
					reg = <0xc000>;
					phandle = <0x5e>;
					#gpio-cells = <0x02>;
					gpio-ranges = <0x5e 0x00 0x00 0x1a>;
					interrupt-controller;

					audio-mclk-pin-active-state {
						function = "func2";
						pins = "gpio13";
						power-source = <0x00>;
					};

					vol-up-key-default-state {
						function = "normal";
						pins = "gpio6";
						qcom,drive-strength = <0x00>;
						phandle = <0xaf>;
						bias-pull-up;
						input-enable;
					};
				};

				pon@800 {
					mode-bootloader = <0x02>;
					mode-recovery = <0x01>;
					compatible = "qcom,pm8998-pon";
					reg = <0x800>;

					resin {
						debounce = <0x3d09>;
						interrupts = <0x00 0x08 0x01 0x03>;
						compatible = "qcom,pm8941-resin";
						status = "okay";
						linux,code = <0x72>;
						bias-pull-up;
					};

					pwrkey {
						debounce = <0x3d09>;
						interrupts = <0x00 0x08 0x00 0x03>;
						compatible = "qcom,pm8941-pwrkey";
						linux,code = <0x74>;
						bias-pull-up;
					};
				};

				adc@3100 {
					#address-cells = <0x01>;
					interrupts = <0x00 0x31 0x00 0x01>;
					#io-channel-cells = <0x01>;
					#size-cells = <0x00>;
					compatible = "qcom,spmi-adc-rev2";
					reg = <0x3100>;
					phandle = <0x5d>;

					channel@6 {
						label = "die_temp";
						reg = <0x06>;
					};
				};

				rtc@6000 {
					reg-names = "rtc", "alarm";
					interrupts = <0x00 0x61 0x01 0x01>;
					compatible = "qcom,pm8941-rtc";
					reg = <0x6000 0x6100>;
				};

				adc-tm@3400 {
					#address-cells = <0x01>;
					interrupts = <0x00 0x34 0x00 0x01>;
					#size-cells = <0x00>;
					#thermal-sensor-cells = <0x01>;
					compatible = "qcom,spmi-adc-tm-hc";
					status = "disabled";
					reg = <0x3400>;
				};
			};

			pmic@5 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,pm8005", "qcom,spmi-pmic";
				reg = <0x05 0x00>;

				regulators {
					compatible = "qcom,pm8005-regulators";
					vdd_s1-supply = <0x17>;

					s1 {
						regulator-max-microvolt = <0x10c8e0>;
						regulator-enable-ramp-delay = <0x1f4>;
						regulator-always-on;
						regulator-min-microvolt = <0xf1360>;
					};
				};
			};

			pmic@3 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,pmi8998", "qcom,spmi-pmic";
				reg = <0x03 0x00>;

				pwm {
					#address-cells = <0x01>;
					#size-cells = <0x00>;
					#pwm-cells = <0x02>;
					compatible = "qcom,pmi8998-lpg";
					status = "disabled";
				};

				led-controller@d300 {
					compatible = "qcom,pmi8998-flash-led", "qcom,spmi-flash-led";
					status = "disabled";
					reg = <0xd300>;
				};

				leds@d800 {
					interrupts = <0x03 0xd8 0x01 0x01 0x03 0xd8 0x02 0x01>;
					label = "backlight";
					compatible = "qcom,pmi8998-wled";
					status = "disabled";
					interrupt-names = "ovp", "short";
					reg = <0xd800 0xd900>;
				};

				labibb {
					compatible = "qcom,pmi8998-lab-ibb";

					ibb {
						interrupts = <0x03 0xdc 0x02 0x01 0x03 0xdc 0x00 0x04>;
						interrupt-names = "sc-err", "ocp";
					};

					lab {
						interrupts = <0x03 0xde 0x01 0x01 0x03 0xde 0x00 0x08>;
						interrupt-names = "sc-err", "ocp";
					};
				};
			};

			pmic@1 {
				#address-cells = <0x01>;
				#size-cells = <0x00>;
				compatible = "qcom,pm8998", "qcom,spmi-pmic";
				reg = <0x01 0x00>;
			};
		};

		i2c@c1b8000 {
			pinctrl-names = "default", "sleep";
			#address-cells = <0x01>;
			pinctrl-0 = <0x89>;
			clock-names = "core", "iface";
			interrupts = <0x00 0x68 0x04>;
			clocks = <0x25 0x3d 0x25 0x36>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			dma-names = "tx", "rx";
			compatible = "qcom,i2c-qup-v2.2.1";
			pinctrl-1 = <0x8a>;
			status = "disabled";
			reg = <0xc1b8000 0x600>;
			dmas = <0x82 0x0c 0x82 0x0d>;
		};

		timer@17920000 {
			#address-cells = <0x01>;
			#size-cells = <0x01>;
			compatible = "arm,armv7-timer-mem";
			ranges;
			reg = <0x17920000 0x1000>;

			frame@17928000 {
				interrupts = <0x00 0x0e 0x04>;
				frame-number = <0x06>;
				status = "disabled";
				reg = <0x17928000 0x1000>;
			};

			frame@17925000 {
				interrupts = <0x00 0x0b 0x04>;
				frame-number = <0x03>;
				status = "disabled";
				reg = <0x17925000 0x1000>;
			};

			frame@17927000 {
				interrupts = <0x00 0x0d 0x04>;
				frame-number = <0x05>;
				status = "disabled";
				reg = <0x17927000 0x1000>;
			};

			frame@17924000 {
				interrupts = <0x00 0x0a 0x04>;
				frame-number = <0x02>;
				status = "disabled";
				reg = <0x17924000 0x1000>;
			};

			frame@17921000 {
				interrupts = <0x00 0x08 0x04 0x00 0x07 0x04>;
				frame-number = <0x00>;
				reg = <0x17921000 0x1000 0x17922000 0x1000>;
			};

			frame@17926000 {
				interrupts = <0x00 0x0c 0x04>;
				frame-number = <0x04>;
				status = "disabled";
				reg = <0x17926000 0x1000>;
			};

			frame@17923000 {
				interrupts = <0x00 0x09 0x04>;
				frame-number = <0x01>;
				status = "disabled";
				reg = <0x17923000 0x1000>;
			};
		};

		i2c@c1b5000 {
			pinctrl-names = "default", "sleep";
			#address-cells = <0x01>;
			pinctrl-0 = <0x83>;
			clock-names = "core", "iface";
			interrupts = <0x00 0x65 0x04>;
			clocks = <0x25 0x37 0x25 0x36>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			dma-names = "tx", "rx";
			compatible = "qcom,i2c-qup-v2.2.1";
			pinctrl-1 = <0x84>;
			status = "disabled";
			reg = <0xc1b5000 0x600>;
			dmas = <0x82 0x06 0x82 0x07>;
		};

		syscon@1f60000 {
			compatible = "qcom,msm8998-tcsr", "syscon";
			reg = <0x1f60000 0x20000>;
			phandle = <0x30>;
		};

		wifi@18800000 {
			iommus = <0xad 0x1900 0xad 0x1901>;
			vdd-1.8-xo-supply = <0x68>;
			qcom,no-msa-ready-indicator;
			clock-names = "cxo_ref_clk_pin";
			reg-names = "membase";
			memory-region = <0xac>;
			interrupts = <0x00 0x19d 0x04 0x00 0x19e 0x04 0x00 0x19f 0x04 0x00 0x1a0 0x04 0x00 0x1a1 0x04 0x00 0x1a2 0x04 0x00 0x1a4 0x04 0x00 0x1a5 0x04 0x00 0x1a6 0x04 0x00 0x1a7 0x04 0x00 0x1a8 0x04 0x00 0x1a9 0x04>;
			clocks = <0x22 0x18>;
			vdd-3.3-ch0-supply = <0x6a>;
			qcom,snoc-host-cap-8bit-quirk;
			compatible = "qcom,wcn3990-wifi";
			status = "okay";
			vdd-0.8-cx-mx-supply = <0xae>;
			reg = <0x18800000 0x800000>;
			vdd-1.3-rfa-supply = <0x69>;
		};

		i2c@c17a000 {
			pinctrl-names = "default", "sleep";
			#address-cells = <0x01>;
			pinctrl-0 = <0x7a>;
			clock-names = "core", "iface";
			interrupts = <0x00 0x64 0x04>;
			clocks = <0x25 0x30 0x25 0x25>;
			#size-cells = <0x00>;
			clock-frequency = <0x61a80>;
			dma-names = "tx", "rx";
			compatible = "qcom,i2c-qup-v2.2.1";
			pinctrl-1 = <0x7b>;
			status = "disabled";
			reg = <0xc17a000 0x600>;
			dmas = <0x66 0x10 0x66 0x11>;
		};

		funnel@6045000 {
			clock-names = "apb_pclk", "atclk";
			clocks = <0x22 0x08 0x22 0x09>;
			compatible = "arm,coresight-dynamic-funnel", "arm,primecell";
			status = "disabled";
			reg = <0x6045000 0x1000>;

			in-ports {
				#address-cells = <0x01>;
				#size-cells = <0x00>;

				port@0 {
					reg = <0x00>;

					endpoint {
						remote-endpoint = <0x42>;
						phandle = <0x3d>;
					};
				};

				port@1 {
					reg = <0x01>;

					endpoint {
						remote-endpoint = <0x43>;
						phandle = <0x3f>;
					};
				};
			};

			out-ports {

				port {

					endpoint {
						remote-endpoint = <0x41>;
						phandle = <0x47>;
					};
				};
			};
		};

		display-subsystem@c900000 {
			power-domains = <0x98 0x04>;
			iommus = <0x99 0x00>;
			#address-cells = <0x01>;
			clock-names = "iface", "bus", "core";
			reg-names = "mdss";
			interrupts = <0x00 0x53 0x04>;
			clocks = <0x98 0x3e 0x98 0x40 0x98 0x43>;
			#size-cells = <0x01>;
			compatible = "qcom,msm8998-mdss";
			ranges;
			#interrupt-cells = <0x01>;
			status = "disabled";
			reg = <0xc900000 0x1000>;
			phandle = <0x9a>;
			interrupt-controller;

			dsi@c996000 {
				power-domains = <0x31 0x00>;
				#address-cells = <0x01>;
				phy-names = "dsi";
				clock-names = "byte", "byte_intf", "pixel", "core", "iface", "bus";
				reg-names = "dsi_ctrl";
				assigned-clocks = <0x98 0x11 0x98 0x30>;
				assigned-clock-parents = <0x96 0x00 0x96 0x01>;
				interrupts = <0x05>;
				clocks = <0x98 0x49 0x98 0x53 0x98 0x42 0x98 0x4b 0x98 0x3e 0x98 0x40>;
				#size-cells = <0x00>;
				interrupt-parent = <0x9a>;
				compatible = "qcom,msm8998-dsi-ctrl", "qcom,mdss-dsi-ctrl";
				status = "disabled";
				phys = <0x96>;
				reg = <0xc996000 0x400>;
