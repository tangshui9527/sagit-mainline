		charge-full-design-microamp-hours = <0x331df0>;
		device-chemistry = "lithium-ion";
		compatible = "simple-battery";
		voltage-max-design-microvolt = <0x432380>;
		constant-charge-voltage-max-microvolt = <0x432380>;
		phandle = <0xb1>;
