			enable-method = "psci";
			phandle = <0x0f>;
		};

		cpu@101 {
			capacity-dmips-mhz = <0x600>;
			cpu-idle-states = <0x05 0x06>;
			device_type = "cpu";
			compatible = "qcom,kryo280";
			next-level-cache = <0x07>;
			reg = <0x00 0x101>;
			enable-method = "psci";
			phandle = <0x0d>;
		};

		idle-states {
			entry-method = "psci";

			cpu-sleep-0-1 {
				entry-latency-us = <0x32e>;
				local-timer-stop;
				idle-state-name = "little-power-collapse";
				exit-latency-us = <0x11d2>;
				arm,psci-suspend-param = <0x40000003>;
				compatible = "arm,idle-state";
				phandle = <0x03>;
				min-residency-us = <0x23df>;
			};

			cpu-sleep-1-0 {
				entry-latency-us = <0x4f>;
				idle-state-name = "big-retention";
				exit-latency-us = <0x52>;
				arm,psci-suspend-param = <0x02>;
				compatible = "arm,idle-state";
				phandle = <0x05>;
				min-residency-us = <0x516>;
			};

			cpu-sleep-0-0 {
				entry-latency-us = <0x51>;
				idle-state-name = "little-retention";
				exit-latency-us = <0x56>;
				arm,psci-suspend-param = <0x02>;
				compatible = "arm,idle-state";
				phandle = <0x02>;
				min-residency-us = <0x1f8>;
			};

			cpu-sleep-1-1 {
				entry-latency-us = <0x2d4>;
				local-timer-stop;
				idle-state-name = "big-power-collapse";
				exit-latency-us = <0x7eb>;
				arm,psci-suspend-param = <0x40000003>;
				compatible = "arm,idle-state";
				phandle = <0x06>;
				min-residency-us = <0x24cb>;
			};
		};

		cpu-map {

			cluster0 {

				core3 {
					cpu = <0x0b>;
				};

				core1 {
					cpu = <0x09>;
				};

				core2 {
					cpu = <0x0a>;
				};

				core0 {
					cpu = <0x08>;
				};
			};

			cluster1 {

				core3 {
					cpu = <0x0f>;
				};

				core1 {
					cpu = <0x0d>;
				};

				core2 {
					cpu = <0x0e>;
				};

				core0 {
					cpu = <0x0c>;
				};
			};
		};

		cpu@2 {
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x02 0x03>;
			device_type = "cpu";
			compatible = "qcom,kryo280";
			next-level-cache = <0x04>;
			reg = <0x00 0x02>;
			enable-method = "psci";
			phandle = <0x0a>;
		};

		cpu@0 {
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x02 0x03>;
			device_type = "cpu";
			compatible = "qcom,kryo280";
			next-level-cache = <0x04>;
			reg = <0x00 0x00>;
			enable-method = "psci";
			phandle = <0x08>;

			l2-cache {
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				phandle = <0x04>;
			};
		};

		cpu@102 {
			capacity-dmips-mhz = <0x600>;
			cpu-idle-states = <0x05 0x06>;
			device_type = "cpu";
			compatible = "qcom,kryo280";
			next-level-cache = <0x07>;
			reg = <0x00 0x102>;
			enable-method = "psci";
			phandle = <0x0e>;
		};

		cpu@100 {
			capacity-dmips-mhz = <0x600>;
			cpu-idle-states = <0x05 0x06>;
			device_type = "cpu";
			compatible = "qcom,kryo280";
			next-level-cache = <0x07>;
			reg = <0x00 0x100>;
			enable-method = "psci";
			phandle = <0x0c>;

			l2-cache {
				cache-level = <0x02>;
				cache-unified;
				compatible = "cache";
				phandle = <0x07>;
			};
		};

		cpu@3 {
			capacity-dmips-mhz = <0x400>;
			cpu-idle-states = <0x02 0x03>;
			device_type = "cpu";
			compatible = "qcom,kryo280";
			next-level-cache = <0x04>;
			reg = <0x00 0x03>;
			enable-method = "psci";
			phandle = <0x0b>;
		};
	};

	reserved-memory {
		#address-cells = <0x02>;
		#size-cells = <0x02>;
		ranges;

		memory@f7800000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf7800000 0x00 0x5000>;
			no-map;
		};

		ramoops@ac000000 {
			record-size = <0x8000>;
			pmsg-size = <0x40000>;
			compatible = "ramoops";
			console-size = <0x80000>;
			reg = <0x00 0xac000000 0x00 0x200000>;
			ftrace-size = <0x20000>;
		};

		memory@85e00000 {
			reg = <0x00 0x85e00000 0x00 0x100000>;
			no-map;
		};

		smem-mem@86000000 {
			reg = <0x00 0x86000000 0x00 0x200000>;
			phandle = <0x1d>;
			no-map;
		};

		memory@9d400000 {
			reg = <0x00 0x9d400000 0x00 0x2400000>;
			no-map;
		};

		memory@95610000 {
			reg = <0x00 0x95610000 0x00 0x5000>;
			no-map;
		};

		memory@95715000 {
			reg = <0x00 0x95715000 0x00 0x100000>;
			phandle = <0xac>;
			no-map;
		};

		mpss-metadata {
			alloc-ranges = <0x00 0xa0000000 0x00 0x20000000>;
			size = <0x00 0x4000>;
			phandle = <0x34>;
			no-map;
		};

		memory@95615000 {
			reg = <0x00 0x95615000 0x00 0x100000>;
			no-map;
		};

		memory@94700000 {
			reg = <0x00 0x94700000 0x00 0xf00000>;
			phandle = <0x3a>;
			no-map;
		};

		memory@85800000 {
			reg = <0x00 0x85800000 0x00 0x600000>;
			no-map;
		};

		memory@8ab00000 {
			reg = <0x00 0x8ab00000 0x00 0x700000>;
			no-map;
		};

		memory@94000000 {
			reg = <0x00 0x94000000 0x00 0x500000>;
			phandle = <0xa8>;
			no-map;
		};

		memory@8d000000 {
			reg = <0x00 0x8d000000 0x00 0x7000000>;
			phandle = <0x33>;
			no-map;
		};

		memory@88f00000 {
			qcom,client-id = <0x01>;
			compatible = "qcom,rmtfs-mem";
			qcom,vmid = <0x0f>;
			reg = <0x00 0x88f00000 0x00 0x200000>;
			no-map;
		};

		memory@86200000 {
			reg = <0x00 0x86200000 0x00 0x2d00000>;
			no-map;
		};

		memory@94500000 {
			reg = <0x00 0x94500000 0x00 0x200000>;
			phandle = <0x32>;
			no-map;
		};

		memory@f7900000 {
			compatible = "shared-dma-pool";
			reg = <0x00 0xf7900000 0x00 0x40000>;
			phandle = <0xfa>;
			no-map;
		};

		memory@8b200000 {
			reg = <0x00 0x8b200000 0x00 0x1e00000>;
			phandle = <0xaa>;
			no-map;
		};

		memory@95600000 {
			reg = <0x00 0x95600000 0x00 0x10000>;
			no-map;
		};
	};

	disp-vddts-regulator {
		regulator-boot-on;
		gpio = <0x27 0x32 0x00>;
		enable-active-high;
		regulator-name = "disp-vddts-regulator";
		compatible = "regulator-fixed";
		phandle = <0x78>;
	};
};
