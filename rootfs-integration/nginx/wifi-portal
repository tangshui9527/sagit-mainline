server {
    listen 80;
    server_name 192.168.12.1 setup.local wifi.local connectivitycheck.gstatic.com clients3.google.com captive.apple.com msftconnecttest.com;

    location / {
        proxy_pass http://127.0.0.1:8088;
        proxy_set_header Host $host;
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 5s;
        proxy_read_timeout 30s;
    }
}
