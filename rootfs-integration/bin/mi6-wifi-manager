#!/usr/bin/env python3
"""
Mi 6 Smart Wi-Fi & Rescue Manager (Reboot-to-AP Architecture).
"""
import os
import sys
import time
import signal
import subprocess

STATE_FILE = '/var/lib/mi6-wifi/mode'
UNMANAGE_CONF = '/etc/NetworkManager/conf.d/99-unmanage-wlan0.conf'
HOSTAPD_CONF = '/etc/hostapd/mi6-ap.conf'
DNSMASQ_CONF = '/etc/mi6-fallback/dnsmasq.conf'
LEASE_FILE = '/var/lib/misc/dnsmasq.leases'

BOOT_GRACE_PERIOD = 45     # seconds to wait for station connection after boot
DISCONNECT_TIMEOUT = 60    # seconds disconnected before rebooting to rescue
RESCUE_IDLE_TIMEOUT = 300  # seconds in rescue mode with no clients before auto-reverting (5 mins)

running = True


def handle_signal(signum, frame):
    global running
    running = False
    subprocess.run(['killall', '-9', 'hostapd', 'dnsmasq'], stdout=subprocess.DEVNULL, stderr=subprocess.DEVNULL)
    sys.exit(0)


signal.signal(signal.SIGTERM, handle_signal)
signal.signal(signal.SIGINT, handle_signal)


def run_cmd(args, timeout=15):
    try:
        res = subprocess.run(args, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=timeout)
        return res.returncode == 0, res.stdout.strip()
    except Exception as e:
        return False, str(e)


def wait_for_interface(ifname='wlan0', timeout=30):
    start = time.time()
    while running and time.time() - start < timeout:
        if os.path.exists(f'/sys/class/net/{ifname}'):
            time.sleep(2)
            return True
        time.sleep(1)
    return False


def get_mode():
    try:
        if os.path.exists(STATE_FILE):
            with open(STATE_FILE, 'r') as f:
                return f.read().strip()
    except Exception:
        pass
    return 'normal'


def set_mode(mode):
    try:
        os.makedirs(os.path.dirname(STATE_FILE), exist_ok=True)
        with open(STATE_FILE, 'w') as f:
            f.write(mode)
    except Exception as e:
        print(f'Error saving mode: {e}', file=sys.stderr)


def is_wifi_connected():
    ok, out = run_cmd(['nmcli', '-t', '-f', 'DEVICE,TYPE,STATE,CONNECTION', 'dev'])
    if not ok:
        return False, None
    for line in out.splitlines():
        parts = line.split(':')
        if len(parts) >= 3 and parts[0] == 'wlan0':
            if parts[2] == 'connected':
                return True, (parts[3] if len(parts) >= 4 else None)
    return False, None


def is_process_running(proc_name):
    ok, out = run_cmd(['pgrep', '-x', proc_name])
    return ok and len(out.strip()) > 0


def has_connected_clients():
    ok, out = run_cmd(['hostapd_cli', 'all_sta'], timeout=3)
    if ok and any(':' in line and len(line.strip()) == 17 for line in out.splitlines()):
        return True

    ok, out = run_cmd(['iw', 'dev', 'wlan0', 'station', 'dump'], timeout=3)
    if ok and 'Station ' in out:
        return True

    try:
        if os.path.exists(LEASE_FILE) and os.path.getsize(LEASE_FILE) > 0:
            return True
    except Exception:
        pass

    return False


def start_ap_services():
    print('[WiFi Manager] Initializing Rescue AP...', flush=True)
    run_cmd(['ip', 'addr', 'flush', 'dev', 'wlan0'])
    run_cmd(['ip', 'link', 'set', 'wlan0', 'down'])
    run_cmd(['mkdir', '-p', '/run/hostapd'])
    time.sleep(1)

    run_cmd(['systemctl', 'stop', 'wpa_supplicant'])
    run_cmd(['killall', '-9', 'wpa_supplicant'])
    run_cmd(['killall', '-9', 'hostapd'])
    run_cmd(['hostapd', '-B', HOSTAPD_CONF, '-P', '/run/mi6-hostapd.pid', '-f', '/var/log/mi6-hostapd.log'])
    time.sleep(2)

    run_cmd(['ip', 'addr', 'add', '10.42.0.1/24', 'broadcast', '10.42.0.255', 'dev', 'wlan0'])
    run_cmd(['ip', 'link', 'set', 'wlan0', 'up'])

    run_cmd(['killall', '-9', 'dnsmasq'])
    run_cmd(['dnsmasq', '-C', DNSMASQ_CONF, '-x', '/run/mi6-dnsmasq.pid', '-u', 'root'])

    run_cmd(['systemctl', 'start', 'mi6-wifi-portal'])
    run_cmd(['systemctl', 'reload-or-restart', 'nginx'])
    print('[WiFi Manager] Hostapd AP, DNS, and Web Portal are live on 10.42.0.1', flush=True)


def enter_rescue_ap_mode():
    print('[WiFi Manager] Rescue mode active. Waiting for wlan0 interface...', flush=True)
    if not wait_for_interface('wlan0', timeout=30):
        print('[WiFi Manager] ERROR: wlan0 interface did not appear!', flush=True)
        return False
    start_ap_services()
    return True


def run_rescue_loop():
    enter_rescue_ap_mode()
    idle_seconds = 0
    check_interval = 5

    while running:
        time.sleep(check_interval)
        if not running:
            break

        if not is_process_running('hostapd'):
            print('[WiFi Manager] hostapd crashed or stopped! Restarting AP...', flush=True)
            start_ap_services()

        if has_connected_clients():
            idle_seconds = 0
            print('[WiFi Manager] Client connected to Rescue AP! Resetting idle timer.', flush=True)
        else:
            idle_seconds += check_interval
            print(f'[WiFi Manager] Rescue AP idle: {idle_seconds}s / {RESCUE_IDLE_TIMEOUT}s', flush=True)
            if idle_seconds >= RESCUE_IDLE_TIMEOUT:
                print('[WiFi Manager] Idle timeout reached. Reverting to Normal mode and rebooting...', flush=True)
                set_mode('normal')
                if os.path.exists(UNMANAGE_CONF):
                    try:
                        os.remove(UNMANAGE_CONF)
                    except Exception:
                        pass
                run_cmd(['sync'])
                run_cmd(['systemctl', 'reboot'])
                sys.exit(0)


def run_normal_loop():
    print(f'[WiFi Manager] Normal station mode. Waiting {BOOT_GRACE_PERIOD}s grace period...', flush=True)
    for _ in range(BOOT_GRACE_PERIOD):
        if not running:
            return
        time.sleep(1)

    disconnect_duration = 0
    check_interval = 10

    while running:
        time.sleep(check_interval)
        if not running:
            break
        connected, con_name = is_wifi_connected()
        if connected:
            disconnect_duration = 0
        else:
            disconnect_duration += check_interval
            print(f'[WiFi Manager] Wi-Fi disconnected ({disconnect_duration}s / {DISCONNECT_TIMEOUT}s)', flush=True)
            if disconnect_duration >= DISCONNECT_TIMEOUT:
                print('[WiFi Manager] Wi-Fi connection lost! Switching to Rescue mode and rebooting...', flush=True)
                set_mode('rescue')
                try:
                    os.makedirs(os.path.dirname(UNMANAGE_CONF), exist_ok=True)
                    with open(UNMANAGE_CONF, 'w') as f:
                        f.write("[keyfile]\nunmanaged-devices=interface-name:wlan0\n")
                except Exception as e:
                    print(f"Error writing unmanage conf: {e}", file=sys.stderr)
                run_cmd(['sync'])
                run_cmd(['systemctl', 'reboot'])
                sys.exit(0)


def main():
    mode = get_mode()
    print(f'[WiFi Manager] Current boot mode: {mode}', flush=True)
    if mode == 'rescue':
        run_rescue_loop()
    else:
        run_normal_loop()


if __name__ == '__main__':
    main()
