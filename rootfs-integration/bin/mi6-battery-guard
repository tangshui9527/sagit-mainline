#!/bin/bash
# Xiaomi Mi 6 Battery Protection & Bypass Charging Daemon
# Uses true PMI8998 SMB2 bypass charging (charge_behaviour=inhibit-charge) when
# available so USB powers VPH_PWR directly while battery remains idle.

STOP_THRESHOLD=${STOP_THRESHOLD:-80}
START_THRESHOLD=${START_THRESHOLD:-70}

# Autodetect battery and charger paths
BATTERY="/sys/class/power_supply/qcom-battery"
[ ! -d "$BATTERY" ] && BATTERY="/sys/class/power_supply/battery"

CHARGER="/sys/class/power_supply/pmi8998-charger"
[ ! -d "$CHARGER" ] && CHARGER="/sys/class/power_supply/pmi8998_charger"

# Ensure standard /sys/class/power_supply/battery symlink for userspace tools
if [ -d "/sys/class/power_supply/qcom-battery" ] && [ ! -e "/sys/class/power_supply/battery" ]; then
    ln -sf qcom-battery /sys/class/power_supply/battery 2>/dev/null || true
fi

logger -t mi6-battery-guard "Daemon started (Battery: $BATTERY, Charger: $CHARGER, Stop: ${STOP_THRESHOLD}%, Resume: ${START_THRESHOLD}%)"

while true; do
    if [ -f "$BATTERY/capacity" ] && [ -d "$CHARGER" ]; then
        CAP=$(cat "$BATTERY/capacity" 2>/dev/null || echo 0)
        VOLT=$(cat "$BATTERY/voltage_now" 2>/dev/null || echo 0)
        CURR=$(cat "$BATTERY/current_now" 2>/dev/null || echo 0)
        TEMP=$(cat "$BATTERY/temp" 2>/dev/null || echo 0)

        if [ -w "$CHARGER/charge_behaviour" ]; then
            BEHAV=$(cat "$CHARGER/charge_behaviour" 2>/dev/null || echo "")
            if [ "$CAP" -ge "$STOP_THRESHOLD" ]; then
                if ! echo "$BEHAV" | grep -q '\[inhibit-charge\]'; then
                    echo inhibit-charge > "$CHARGER/charge_behaviour" 2>/dev/null || true
                    logger -t mi6-battery-guard "[BYPASS] Battery at ${CAP}% >= ${STOP_THRESHOLD}%. Entered bypass charging (inhibit-charge). (V=${VOLT}uV, I=${CURR}uA, T=${TEMP}mC)"
                fi
            elif [ "$CAP" -le "$START_THRESHOLD" ]; then
                if echo "$BEHAV" | grep -q '\[inhibit-charge\]'; then
                    echo auto > "$CHARGER/charge_behaviour" 2>/dev/null || true
                    logger -t mi6-battery-guard "[RESUMED] Battery at ${CAP}% <= ${START_THRESHOLD}%. Resumed normal charging (auto). (V=${VOLT}uV, I=${CURR}uA, T=${TEMP}mC)"
                fi
            fi
        fi
    fi
    sleep 30
done
