def do_wifi_scan():
    try:
        cmd = ['nmcli', '-t', '-f', 'SSID,SIGNAL,SECURITY,CHAN', 'dev', 'wifi', 'list', '--rescan', 'yes']
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=10)
        lines = res.stdout.strip().splitlines()
        networks = []
        seen = set()
        for line in lines:
            parts = line.split(':')
            if len(parts) >= 2:
                ssid = parts[0].strip()
                if not ssid or ssid == 'Mi6-Setup-AP' or ssid in seen:
                    continue
                seen.add(ssid)
                signal = int(parts[1]) if parts[1].isdigit() else 50
                security = parts[2] if len(parts) >= 3 else ''
                chan = parts[3] if len(parts) >= 4 else ''
                networks.append({'ssid': ssid, 'signal': signal, 'security': security, 'chan': chan})
        networks.sort(key=lambda x: x['signal'], reverse=True)
        return networks
    except Exception as e:
        print(f"Scan error: {e}", file=sys.stderr)
        return []

def connect_in_background(ssid, password):
    time.sleep(2)
    print(f"Connecting to {ssid} in background...", flush=True)
    try:
        subprocess.run(['nmcli', 'connection', 'down', FALLBACK_AP], timeout=15)
        time.sleep(1)
        cmd = ['nmcli', 'dev', 'wifi', 'connect', ssid]
        if password:
            cmd.extend(['password', password])
        print(f"Running: {' '.join(cmd)}", flush=True)
        res = subprocess.run(cmd, stdout=subprocess.PIPE, stderr=subprocess.PIPE, text=True, timeout=30)
        print(f"Connect stdout: {res.stdout}", flush=True)
        print(f"Connect stderr: {res.stderr}", flush=True)
    except Exception as e:
        print(f"Background connect failed: {e}", file=sys.stderr)

class PortalHandler(http.server.BaseHTTPRequestHandler):
    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        captive_paths = [
            '/generate_204', '/gen_204', '/ncsi.txt', '/connecttest.txt',
            '/hotspot-detect.html', '/canonical.html', '/success.txt'
        ]
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path in captive_paths:
            self.send_response(302)
            self.send_header('Location', 'http://192.168.12.1/')
            self.end_headers()
            return

        if path == '/' or path == '/index.html':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_TEMPLATE.encode('utf-8'))
            return

        if path == '/api/scan':
            networks = do_wifi_scan()
            data = json.dumps(networks).encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(data)
            return

        if path == '/api/status':
            data = json.dumps({'status': 'ap_mode', 'ip': '192.168.12.1', 'device': 'Xiaomi Mi 6'}).encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(data)
            return

        self.send_response(302)
        self.send_header('Location', 'http://192.168.12.1/')
        self.end_headers()

    def do_POST(self):
        if self.path == '/api/connect':
            length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(length).decode('utf-8')
            try:
                payload = json.loads(body)
                ssid = payload.get('ssid', '').strip()
                password = payload.get('password', '')

                if not ssid:
                    self.send_response(400)
                    self.send_header('Content-Type', 'application/json')
                    self.end_headers()
                    self.wfile.write(json.dumps({'error': 'SSID cannot be empty'}).encode('utf-8'))
                    return

                resp = json.dumps({
                    'status': 'ok',
                    'message': f'正在切换连接到 {ssid}，热点将自动关闭。如连接成功，请在路由器查看设备新 IP。'
                }).encode('utf-8')
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(resp)

                threading.Thread(target=connect_in_background, args=(ssid, password), daemon=True).start()
                return
            except Exception as e:
                self.send_response(500)
                self.end_headers()
                self.wfile.write(json.dumps({'error': str(e)}).encode('utf-8'))
                return

        self.send_response(404)
        self.end_headers()

    def log_message(self, format, *args):
        sys.stderr.write("%s - - [%s] %s\n" % (self.address_string(), self.log_date_time_string(), format%args))

class ReusableTCPServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = True

if __name__ == '__main__':
    print(f"Starting Mi 6 Wi-Fi Setup Portal on port {PORT}...", flush=True)
    with ReusableTCPServer(('0.0.0.0', PORT), PortalHandler) as httpd:
        httpd.serve_forever()
