PORT = 8088


def get_clamped_mac():
    """Return configured static MAC from NM conf.d or current wlan0 MAC if valid."""
    conf_files = [
        '/etc/NetworkManager/conf.d/disable-random-mac.conf',
        '/etc/NetworkManager/conf.d/00-mac-clamping.conf',
    ]
    for path in conf_files:
        try:
            if os.path.exists(path):
                with open(path, 'r') as f:
                    for line in f:
                        m = re.match(r'^\s*wifi\.cloned-mac-address\s*=\s*([0-9a-fA-F:]{17})\s*$', line)
                        if m:
                            return m.group(1).upper()
        except Exception:
            pass
    try:
        addr_path = '/sys/class/net/wlan0/address'
        if os.path.exists(addr_path):
            mac = open(addr_path, 'r').read().strip().upper()
            if re.match(r'^[0-9A-F:]{17}$', mac) and mac != '00:00:00:00:00:00':
                return mac
    except Exception:
        pass
    return None


