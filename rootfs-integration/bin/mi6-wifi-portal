    <script>
        function togglePassword() {
            const input = document.getElementById('passwordInput');
            input.type = input.type === 'password' ? 'text' : 'password';
        }

        async function scanWifi() {
            const listEl = document.getElementById('wifiList');
            listEl.innerHTML = '<div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px;">正在扫描附近的无线网络...</div>';
            try {
                const res = await fetch('/api/scan');
                const networks = await res.json();
                if (!networks || networks.length === 0) {
                    listEl.innerHTML = '<div style="padding: 24px; text-align: center; color: var(--text-muted); font-size: 13px;">未搜索到周围的 Wi-Fi，请点击右上角刷新</div>';
                    return;
                }
                listEl.innerHTML = '';
                networks.forEach(net => {
                    const item = document.createElement('div');
                    item.className = 'wifi-item';
                    const icon = net.signal > 70 ? '📶' : (net.signal > 40 ? '🛜' : '📡');
                    const lock = net.security && !net.security.includes('--') ? '🔒' : '';
                    item.innerHTML = `
                        <span class="wifi-name">${escapeHtml(net.ssid)}</span>
                        <div class="wifi-meta">
                            <span>${lock}</span>
                            <span>${net.signal}%</span>
                            <span>${icon}</span>
                        </div>
                    `;
                    item.onclick = () => selectWifi(net.ssid);
                    listEl.appendChild(item);
                });
            } catch (err) {
                listEl.innerHTML = '<div style="padding: 24px; text-align: center; color: #ef4444; font-size: 13px;">扫描失败，请重试</div>';
            }
        }

        function escapeHtml(str) {
            return str.replace(/[&<>'"]/g, tag => ({
                '&': '&amp;', '<': '&lt;', '>': '&gt;', "'": '&#39;', '"': '&quot;'
            }[tag] || tag));
        }

        function selectWifi(ssid) {
            document.getElementById('ssidInput').value = ssid;
            document.querySelectorAll('.wifi-item').forEach(el => {
                const name = el.querySelector('.wifi-name').innerText;
                el.classList.toggle('selected', name === ssid);
            });
            document.getElementById('passwordInput').focus();
        }

        async function handleConnect(e) {
            e.preventDefault();
            const ssid = document.getElementById('ssidInput').value.trim();
            const password = document.getElementById('passwordInput').value;
            const btn = document.getElementById('submitBtn');
            const statusBox = document.getElementById('statusBox');

            if (!ssid) return;

            btn.disabled = true;
            btn.innerText = '正在配置连接...';
            statusBox.className = 'status-box loading';
            statusBox.innerHTML = `正在向小米 6 提交连接指令...<br>热点将在几秒后自动关闭，设备尝试接入 <b>${escapeHtml(ssid)}</b>。<br>如果连接成功，手机即可在路由器查看设备新 IP。`;

            try {
                const res = await fetch('/api/connect', {
                    method: 'POST',
                    headers: {'Content-Type': 'application/json'},
                    body: JSON.stringify({ ssid, password })
                });
                const data = await res.json();
                statusBox.className = 'status-box success';
                statusBox.innerHTML = `✅ <b>配置指令已提交！</b><br>${data.message || '热点已切换，请等待小米 6 连入路由器。'}`;
            } catch (err) {
                statusBox.className = 'status-box error';
                statusBox.innerHTML = '❌ 提交失败，请检查手机是否仍连在热点上。';
                btn.disabled = false;
                btn.innerText = '保存并立即连接';
            }
        }

        scanWifi();
    </script>
</body>
</html>
