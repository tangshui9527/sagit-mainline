        function togglePassword() {
            const input = document.getElementById('passwordInput');
            const btn = document.getElementById('togglePwdBtn');
            if (input.type === 'text') {
                input.type = 'password';
                btn.innerText = '显示';
            } else {
                input.type = 'text';
                btn.innerText = '隐藏';
