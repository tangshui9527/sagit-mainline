def connect_in_background(ssid, password):
    time.sleep(2)
    print(f"Saving credentials for {ssid}...", flush=True)
    safe_name = "".join(c for c in ssid if c.isalnum() or c in "-_") or "saved-wifi"
    con_path = f"/etc/NetworkManager/system-connections/{safe_name}.nmconnection"
    con_uuid = str(uuid.uuid4())
    clamped_mac = get_clamped_mac()
    mac_line = f"cloned-mac-address={clamped_mac}\n" if clamped_mac else ""

    security_block = ""
    if password:
        security_block = f"""
[wifi-security]
auth-alg=open
key-mgmt=wpa-psk
psk={password}
"""

    nm_block = f"""[connection]
id={ssid}
uuid={con_uuid}
type=wifi
interface-name=wlan0
autoconnect=true
autoconnect-priority=100

[wifi]
{mac_line}mode=infrastructure
powersave=2
ssid={ssid}
{security_block}
[ipv4]
method=auto

[ipv6]
addr-gen-mode=default
method=auto
"""
    try:
        with open(con_path, 'w') as f:
            f.write(nm_block)
        os.chmod(con_path, 0o600)
        print(f"Wrote {con_path}", flush=True)

        os.makedirs('/var/lib/mi6-wifi', exist_ok=True)
        with open('/var/lib/mi6-wifi/mode', 'w') as f:
            f.write('normal')

        unmanage_conf = '/etc/NetworkManager/conf.d/99-unmanage-wlan0.conf'
        if os.path.exists(unmanage_conf):
            try:
                os.remove(unmanage_conf)
            except Exception:
                pass

        subprocess.run(['sync'])
        time.sleep(2)
        print("Rebooting to connect to " + ssid + "...", flush=True)
        subprocess.run(['systemctl', 'reboot'])
    except Exception as e:
        print(f"Save and reboot failed: {e}", file=sys.stderr, flush=True)


class PortalHandler(http.server.BaseHTTPRequestHandler):
    def do_HEAD(self):
        self.do_GET()

    def do_GET(self):
        captive_paths = [
            '/generate_204', '/gen_204', '/ncsi.txt', '/connecttest.txt',
            '/hotspot-detect.html', '/canonical.html', '/success.txt'
        ]
        parsed = urllib.parse.urlparse(self.path)
        path = parsed.path

        if path in captive_paths:
            self.send_response(302)
            self.send_header('Location', 'http://10.42.0.1/')
            self.end_headers()
            return

        if path == '/' or path == '/index.html':
            self.send_response(200)
            self.send_header('Content-Type', 'text/html; charset=utf-8')
            self.end_headers()
            self.wfile.write(HTML_TEMPLATE.encode('utf-8'))
            return

        if path == '/api/status':
            data = json.dumps({'status': 'ap_mode', 'ip': '10.42.0.1', 'device': 'Xiaomi Mi 6'}).encode('utf-8')
            self.send_response(200)
            self.send_header('Content-Type', 'application/json')
            self.end_headers()
            self.wfile.write(data)
            return

        self.send_response(302)
        self.send_header('Location', 'http://10.42.0.1/')
        self.end_headers()

    def do_POST(self):
        if self.path == '/api/connect':
            length = int(self.headers.get('Content-Length', 0))
            body = self.rfile.read(length).decode('utf-8')
            try:
                payload = json.loads(body)
                ssid = payload.get('ssid', '').strip()
                password = payload.get('password', '')

                if not ssid:
                    self.send_response(400)
                    self.send_header('Content-Type', 'application/json')
                    self.end_headers()
                    self.wfile.write(json.dumps({'error': 'SSID cannot be empty'}).encode('utf-8'))
                    return

                resp = json.dumps({
                    'status': 'ok',
                    'message': f'正在切换连接到 {ssid}（预计 20~30 秒），固定 MAC 已保持，连接成功后即可通过局域网恢复访问。'
                }).encode('utf-8')
                self.send_response(200)
                self.send_header('Content-Type', 'application/json')
                self.end_headers()
                self.wfile.write(resp)

                threading.Thread(target=connect_in_background, args=(ssid, password), daemon=True).start()
                return
            except Exception as e:
                self.send_response(500)
                self.end_headers()
                self.wfile.write(json.dumps({'error': str(e)}).encode('utf-8'))
                return

        self.send_response(404)
        self.end_headers()

    def log_message(self, format, *args):
        sys.stderr.write("%s - - [%s] %s\n" % (self.address_string(), self.log_date_time_string(), format % args))


class ReusableTCPServer(socketserver.ThreadingTCPServer):
    allow_reuse_address = True


if __name__ == '__main__':
    print(f"Starting Mi 6 Wi-Fi Setup Portal on port {PORT}...", flush=True)
    with ReusableTCPServer(('0.0.0.0', PORT), PortalHandler) as httpd:
        httpd.serve_forever()
