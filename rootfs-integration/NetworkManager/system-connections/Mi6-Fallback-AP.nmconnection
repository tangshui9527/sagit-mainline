[connection]
id=Mi6-Fallback-AP
uuid=370ad706-a25f-4bf4-a79d-643d587ca273
type=wifi
autoconnect=false
interface-name=wlan0

[wifi]
band=bg
channel=6
mode=ap
ssid=Mi6-Setup-AP

[wifi-security]
key-mgmt=wpa-psk
psk=sagitsetup123

[ipv4]
address1=192.168.12.1/24
method=shared

[ipv6]
addr-gen-mode=default
method=disabled

[proxy]
