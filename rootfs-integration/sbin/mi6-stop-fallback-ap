#!/bin/bash
echo "[Fallback] Stopping Hostapd AP mode..."
killall -9 hostapd 2>/dev/null
killall -9 dnsmasq 2>/dev/null
systemctl stop mi6-wifi-portal 2>/dev/null
ip addr flush dev wlan0
ip link set wlan0 down
sleep 1

systemctl restart wpa_supplicant 2>/dev/null
nmcli dev set wlan0 managed yes 2>/dev/null
sleep 2
