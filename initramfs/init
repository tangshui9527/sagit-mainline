#!/bin/sh
export PATH=/bin:/sbin:/usr/bin:/usr/sbin
/bin/busybox mkdir -p /proc /sys /dev /dev/pts /tmp /run /etc /usr/bin /usr/sbin
/bin/busybox --install -s
mount -t proc proc /proc
mount -t sysfs sysfs /sys
mount -t devtmpfs devtmpfs /dev
mount -t devpts devpts /dev/pts 2>/dev/null

# Foreground Serial Console on ttyGS0 (PID 1)
export PS1='sagit# '
export TERM=vt100
while true; do
    if [ -c /dev/ttyGS0 ]; then
        echo "<6>sagit-mainline: starting shell on ttyGS0" > /dev/kmsg
        echo "" > /dev/ttyGS0
        echo "=== Welcome to Xiaomi 6 (Sagit) Mainline Linux 7.2 ===" > /dev/ttyGS0
        echo "Tip: Run 'touch /tmp/stay' to cancel the 60s auto-reboot." > /dev/ttyGS0
        echo "" > /dev/ttyGS0
        /bin/sh </dev/ttyGS0 >/dev/ttyGS0 2>&1
    fi
    sleep 1
done
